# Copy to `.env.local` for development; configure in Vercel project settings for production.

# Canonical site URL — used in metadata, sitemap, robots, and JSON-LD.
# Must be the serving host (www), so canonicals/hreflang don't resolve via a redirect.
NEXT_PUBLIC_SITE_URL="https://www.wellowork.net"

# Supabase project URL and keys.
# - Public anon key may be exposed to the browser (it is gated by Row-Level Security).
# - Service-role key is server-only. NEVER prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Cal.com booking integration.
# - NEXT_PUBLIC_CALCOM_LINK is the path or full URL of your booking page. The
#   iframe on /book-a-demo will render https://cal.eu/<path> by default; if you
#   supply a full URL, it is used verbatim. Both cal.com and cal.eu accounts
#   share the same slug structure, so any of these are valid:
#       wellowork/30min
#       team/wellowork/manager-demo
#       https://cal.eu/wellowork/30min
#       https://cal.com/wellowork/30min
#   If unset, /book-a-demo renders the fallback "Request a demo time" form.
# - CALCOM_WEBHOOK_SECRET is the secret configured on the Cal.com webhook that
#   targets /api/calcom-webhook. Used to verify the HMAC-SHA256 signature on
#   incoming payloads. Server-side only.
NEXT_PUBLIC_CALCOM_LINK=""
CALCOM_WEBHOOK_SECRET=""

# Resend transactional email. Server-side only — never expose RESEND_API_KEY
# to the browser. RESEND_FROM_EMAIL must be on a domain verified in Resend.
# RESEND_REPLY_TO is optional and defaults to info@wellowork.net.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="WelloWork <noreply@wellowork.net>"
RESEND_REPLY_TO="info@wellowork.net"
