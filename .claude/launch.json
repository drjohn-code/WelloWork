{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "playtest",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "playtest"
      ],
      "port": 3000
    },
    {
      "name": "qa-bridge",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "GAME_MASTER_BRIDGE_DIR=.gm-bridge",
        "PAYMENT_MOCK_MODE=true",
        "npm",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "qa-offline",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "GAME_MASTER_BRIDGE_DIR=.gm-bridge",
        "GAME_MASTER_BRIDGE_TIMEOUT_SEC=1",
        "PAYMENT_MOCK_MODE=true",
        "npm",
        "run",
        "dev"
      ],
      "port": 3000
    }
  ]
}
